{
  "name": "pug-public",
  "main": "worker/public.js",
  "compatibility_date": "2026-09-14",
  "account_id": "953e6b157cc6a36fcdf1bf65eee31879",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "node scripts/prepare-public.mjs"
  },
  "assets": {
    "directory": "./dist-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "pigeonumbragroup.com/*",
      "zone_name": "pigeonumbragroup.com"
    },
    {
      "pattern": "www.pigeonumbragroup.com/*",
      "zone_name": "pigeonumbragroup.com"
    }
  ]
}
