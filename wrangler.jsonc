{
  "name": "pug-admin",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-08",
  "account_id": "953e6b157cc6a36fcdf1bf65eee31879",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "services": [{ "binding": "DATACENTER", "service": "datacenterdata" }],
  "routes": [
    { "pattern": "admin.pigeonumbragroup.com", "custom_domain": true },
  ],
}
